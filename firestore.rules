rules_version = '2';

// Baseline rules for the Firebase free tier: any authenticated request may
// read/write (the app signs in anonymously — see src/lib/firebase.ts — and
// gates real access with the in-app Shop PIN, which is NOT a security
// boundary by itself). Tighten with custom claims before going beyond
// internal shop use.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
